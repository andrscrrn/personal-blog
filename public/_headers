# Cloudflare Pages headers. Later rules override earlier ones per header.

# HTML and everything unhashed: revalidate on every visit
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed build assets never change under the same name
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are versioned by hand and effectively immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# OG images and covers change rarely
/og/*
  Cache-Control: public, max-age=86400
/projects/*.webp
  Cache-Control: public, max-age=86400
/projects/*.svg
  Cache-Control: public, max-age=86400
