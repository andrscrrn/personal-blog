---
import StatusRing from "./StatusRing.astro";

export type Entry = {
  key: string;
  href: string;
  meta?: string;
  title: string;
  /** Adds the Active status pill after the title. */
  active?: boolean;
  description?: string;
  image?: string;
  /** Draw the generated Status Ring thumbnail; takes precedence over image. */
  statusRing?: boolean;
};

type Props = { entries: Entry[]; delayStart?: number };
const { entries, delayStart = 0 } = Astro.props;
---
<div>
  <ul>
    {
      entries.map((entry, i) => (
        <li
          class="fade-up border-t border-hairline"
          style={`--delay: ${delayStart + i * 80}ms`}
        >
          <a
            href={entry.href}
            class="post-row flex items-center justify-between gap-6 py-7"
          >
            <span class="post-text flex min-w-0 flex-col gap-2">
              {entry.meta && <span class="meta-label">{entry.meta}</span>}
              <span class="post-link text-[22px] font-medium leading-[1.3] sm:text-[26px]">
                {entry.title}
                {entry.active && (
                  <span class="status-pill live ml-3 align-[4px]">Active</span>
                )}
              </span>
              {entry.description && (
                <span class="text-[16px] leading-[1.55] text-secondary">
                  {entry.description}
                </span>
              )}
            </span>
            {entry.statusRing ? (
              <span class="post-thumb h-[88px] w-[88px] shrink-0 overflow-hidden rounded-[4px] border border-hairline sm:h-28 sm:w-28">
                <StatusRing variant="thumb" />
              </span>
            ) : entry.image ? (
              <span class="post-thumb h-[88px] w-[88px] shrink-0 overflow-hidden rounded-[4px] border border-hairline sm:h-28 sm:w-28">
                <img
                  src={entry.image}
                  alt=""
                  width="112"
                  height="112"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </span>
            ) : null}
          </a>
        </li>
      ))
    }
  </ul>
  <div
    class="fade-up border-t border-hairline"
    style={`--delay: ${delayStart + entries.length * 80}ms`}
    aria-hidden="true"
  >
  </div>
</div>
