---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

type Props = {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  /** Site-relative or absolute URL; omitted entirely when a page has none. */
  ogImage?: string;
  publishedTime?: string;
  tags?: string[];
};

const SITE_NAME = "Andres Carreño Blog";
const {
  title,
  description = "Thoughts, notes, and projects",
  ogType = "website",
  ogImage,
  publishedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} • ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={new URL("feed.xml", Astro.site)}
    />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- Newsreader 400 sets the above-the-fold body and headings; the other
         weights and the italic swap in without a preload. -->
    <link
      rel="preload"
      href="/fonts/newsreader-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>
  <body>
    <div class="mx-auto flex min-h-dvh w-full max-w-[680px] flex-col px-4">
      <SiteHeader />
      <main class="flex flex-1 flex-col"><slot /></main>
    </div>
  </body>
</html>
