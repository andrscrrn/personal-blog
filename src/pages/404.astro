---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<BaseLayout title="Not found" description="This page does not exist">
  <div class="flex flex-1 flex-col">
    <h1 class="fade-up mb-8 text-[32px] font-normal leading-[1.2] tracking-[-0.01em]">
      Page not found
    </h1>
    <p class="fade-up text-[18px] italic leading-[1.6] text-secondary" style="--delay: 90ms">
      The page you are looking for does not exist or has moved.
    </p>
    <p class="fade-up mt-8" style="--delay: 180ms">
      <a
        href="/"
        class="back-link text-[15px] italic text-secondary hover:text-foreground"
      >
        <span class="arrow" aria-hidden="true">←</span> Back home
      </a>
    </p>
    <SiteFooter />
  </div>
</BaseLayout>
