---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import { postImage, readingTimeMinutes, type Post } from "../../lib/posts";
import { formatDate } from "../../lib/date";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: Post };
const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTimeMinutes(post.body ?? "");
const image = postImage(post);
const publishedTime = post.data.date.toISOString();
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={image}
  publishedTime={publishedTime}
  tags={post.data.tags}
>
  <div class="flex flex-1 flex-col">
    <article class="mb-16">
      <header>
        <p class="fade-up meta-label mb-4">
          <time datetime={publishedTime}>{formatDate(post.data.date)}</time>
          {" · "}{minutes} min read
        </p>
        <h1
          class="fade-up mb-8 text-[34px] font-normal leading-[1.2] tracking-[-0.01em] sm:text-[44px]"
          style="--delay: 80ms"
        >
          {post.data.title}
        </h1>
        {post.data.description && (
          <p
            class="fade-up mb-12 text-[20px] italic leading-[1.6] text-secondary"
            style="--delay: 160ms"
          >
            {post.data.description}
          </p>
        )}
        <div
          class="fade-up mb-12 border-t border-hairline"
          style="--delay: 240ms"
          aria-hidden="true"
        >
        </div>
        {image && (
          <img
            src={image}
            alt={post.data.title}
            width="1200"
            height="630"
            fetchpriority="high"
            decoding="async"
            class="fade-up mb-12 w-full rounded-[4px] border border-hairline object-cover"
            style="--delay: 300ms"
          />
        )}
      </header>
      <div class="fade-up post-body" style="--delay: 360ms">
        <Content />
      </div>
    </article>
    <footer class="mt-auto flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-t border-hairline pt-8 pb-14">
      <a
        href="/"
        class="back-link text-[15px] italic text-secondary hover:text-foreground"
      >
        <span class="arrow" aria-hidden="true">←</span>{" "}All posts
      </a>
      <SocialLinks />
    </footer>
  </div>
</BaseLayout>
